<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="#F0F5FF">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="XATU Helper" android:textColor="#173B70" android:textSize="16sp" android:textStyle="bold" />
    <TextView android:id="@+id/widget_content" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:textColor="#172335" android:textSize="13sp" android:maxLines="7" android:ellipsize="end" />
</LinearLayout>
